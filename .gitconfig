[user]
    name = Aleksei Malykh
    email = 49870662+ysomad@users.noreply.github.com
	signingkey = 4725F43EE3A3F86C84D56EF000FB366088A4D4CA

[commit]
	gpgsign = true
[url "git@github.com:droppmarket/"]
	insteadOf = https://github.com/droppmarket/
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft-themed "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[alias]
	difft = -c diff.external=difft-themed diff
# delta colors, linked by bin/theme
[include]
	path = ~/.config/delta/theme.gitconfig
